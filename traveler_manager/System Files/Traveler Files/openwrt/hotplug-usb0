#!/bin/sh
# The Lookout - /etc/hotplug.d/net/30-lookout-usb0
# Address the radio's USB link whenever it appears, so the box tracks even when the
# radio is plugged in AFTER power-on (not just during the boot window).
# Install:  cp to /etc/hotplug.d/net/30-lookout-usb0  (no chmod needed; hotplug sources it)

[ "$ACTION" = "add" ] || exit 0
[ "$INTERFACE" = "usb0" ] || [ "$DEVICENAME" = "usb0" ] || exit 0

ip addr add 10.250.46.100/24 dev usb0 2>/dev/null
ip link set usb0 up 2>/dev/null
