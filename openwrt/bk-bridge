#!/bin/sh /etc/rc.common
# The Lookout - radio -> NMEA bridge, as an OpenWrt boot service (procd).
# Install:  put in /etc/init.d/, chmod +x, then /etc/init.d/bk-bridge enable

USE_PROCD=1
START=95
STOP=10

start_service() {
    # Wait up to 15s for the radio's usb0 to appear at boot, then address it.
    i=0
    while [ $i -lt 15 ] && ! ip link show usb0 >/dev/null 2>&1; do
        sleep 1
        i=$((i + 1))
    done
    ip addr add 10.250.46.100/24 dev usb0 2>/dev/null
    ip link set usb0 up 2>/dev/null

    # Free a Garmin GPS 18 USB from the kernel serial driver so the bridge's libusb
    # reader can claim it (the box's own "you are here" position). No-op if absent.
    rmmod garmin_gps 2>/dev/null

    procd_open_instance
    procd_set_param command /usr/bin/python3 /root/bk_bridge.py
    procd_set_param respawn
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
