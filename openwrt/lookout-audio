#!/bin/sh /etc/rc.common
# The Lookout - radio audio streamer, as an OpenWrt boot service (procd).
# OPTIONAL + fully isolated: streams the USB sound card's PCM on :8081 for the
# map's Listen button. Starts after units-kml; if no sound card is present it
# just retries harmlessly and nothing else is affected.
# Install:  put in /etc/init.d/, chmod +x, then /etc/init.d/lookout-audio enable

USE_PROCD=1
START=97
STOP=10

start_service() {
    procd_open_instance
    procd_set_param command /usr/bin/python3 /root/lookout_audio.py
    procd_set_param respawn
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
